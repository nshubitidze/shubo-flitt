<?xml version="1.0"?>
<!-- A theme or module styles the embedded card form by adding config/widgetOptions to the
     shubo-flitt-payments item below in its own checkout_index_index.xml: Flitt checkout-vue
     options (options, messages, css_variable…; strings take translate="true"). Keys that
     change the payment flow are ignored — see the method renderer's buildOptions(). -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="billing-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="payment" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="renders" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="shubo-flitt-payments" xsi:type="array">
                                                                    <item name="component" xsi:type="string">Shubo_Flitt/js/view/payment/flitt-payments</item>
                                                                    <item name="methods" xsi:type="array">
                                                                        <item name="shubo_flitt" xsi:type="array">
                                                                            <item name="isBillingAddressRequired" xsi:type="boolean">true</item>
                                                                        </item>
                                                                    </item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
