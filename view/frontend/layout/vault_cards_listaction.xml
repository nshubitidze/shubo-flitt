<?xml version="1.0"?>
<!-- My Account → Stored Payment Methods: register the renderer that claims
     shubo_flitt card tokens — the core list block skips unclaimed tokens. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="vault.cards.list">
            <block class="Shubo\Flitt\Block\Customer\CardRenderer"
                   name="shubo_flitt.card.renderer"
                   template="Magento_Vault::customer_account/credit_card.phtml"/>
        </referenceBlock>
    </body>
</page>
